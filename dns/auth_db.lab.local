$ORIGIN lab.local.
$TTL 3600

@	IN	SOA	ns.lab.local. root.lab.local. (
		2026030601	; Serial
		28800	; Refresh (8 hours)
		7200	; Retry (2 hours)
		86400	; Expire (24 hours)
		3600 )	; Negative TTL (1 hour)

	IN	NS	ns.lab.local.

	IN	MX	10	mx.lab.local.

ns	IN	A	192.168.10.10
mx	IN	A	192.168.10.10
www	IN	A	192.168.20.20
